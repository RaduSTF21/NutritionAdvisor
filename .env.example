# Copy this file to `.env` and fill with real secrets. Do NOT commit `.env` to git.

# Database
POSTGRES_USER=nutrition_user
POSTGRES_PASSWORD=nutrition_pass
POSTGRES_DB=nutrition_db
ConnectionStrings__DefaultConnection=Host=postgres;Database=nutrition_db;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# ASP.NET / JWT
Jwt__Key=CHANGE_ME_TO_A_SECURE_KEY_WITH_AT_LEAST_32_CHARS
Jwt__Issuer=NutritionAdvisor
Jwt__Audience=NutritionAdvisorUsers

# Python AI service
# Set your Gemini API key here (example: GEMINI_API_KEY=ya29...)
GEMINI_API_KEY=
# Supported values include gemini-flash-latest, gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-flash-latest
# The URL the API should use to call the AI service when running in docker-compose
PythonAI__BaseUrl=http://ai_service:8000

# Stripe (use test keys for local development)
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__Domain=http://localhost:5210

# Other environment overrides
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
