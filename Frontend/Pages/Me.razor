@page "/me"
@using MudBlazor
@using Microsoft.AspNetCore.Components
@using System.Net
@using System.Net.Http.Json
@using System.Security.Claims
@using NutritionAdvisor.Domain.Entities
@using NutritionAdvisor.Domain.Enums
@using Frontend.Models
@using Frontend.Auth
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" GutterBottom="true">Account & Personal</MudText>

    <MudExpansionPanels>
        <MudExpansionPanel Text="Profile">
            @if (editing)
            {
                <MudTextField Label="Name" @bind-Value="user.Name" />
                <MudSelect Label="Gender" @bind-Value="user.Gender">
                    <MudSelectItem Value="@("Male")">Male</MudSelectItem>
                    <MudSelectItem Value="@("Female")">Female</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                </MudSelect>
                <MudSelect Label="Objective" @bind-Value="user.Objective">
                    <MudSelectItem Value="@("Weight Loss")">Weight Loss</MudSelectItem>
                    <MudSelectItem Value="@("Maintain")">Maintain</MudSelectItem>
                    <MudSelectItem Value="@("Muscle Gain")">Muscle Gain</MudSelectItem>
                </MudSelect>
                <MudNumericField Label="Age" @bind-Value="user.Age" />
                <MudNumericField Label="Weight (kg)" @bind-Value="user.Weight" />
                <MudNumericField Label="Height (cm)" @bind-Value="user.Height" />
                <MudTextField Label="Allergies" @bind-Value="user.Allergies" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProfile">Save</MudButton>
            }
            else
            {
                <MudText Typo="Typo.h6">Name: <b>@user.Name</b></MudText>
                <MudText Typo="Typo.body2">Gender: @user.Gender</MudText>
                <MudText Typo="Typo.body2">Objective: @user.Objective</MudText>
                <MudText Typo="Typo.body2">Age: @user.Age</MudText>
                <MudText Typo="Typo.body2">Weight: @user.Weight kg</MudText>
                <MudText Typo="Typo.body2">Height: @user.Height cm</MudText>
                <MudText Typo="Typo.body2">Allergies: @user.Allergies</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => editing = true">Edit
                </MudButton>
            }
        </MudExpansionPanel>

        <MudExpansionPanel Text="Allergies">
            <MudPaper Class="pa-4 mb-4">
                <MudTextField Label="Allergen name" @bind-Value="newAllergy.AllergenName" Class="mb-3" />

                <MudSelect T="AllergySeverity" Label="Severity" @bind-Value="newAllergy.SeverityLevel" Class="mb-4">
                    @foreach (var severity in Enum.GetValues<AllergySeverity>())
                    {
                        <MudSelectItem T="AllergySeverity" Value="@severity">@severity</MudSelectItem>
                    }
                </MudSelect>

                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddAllergy">Add Allergy</MudButton>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" GutterBottom="true">Saved Allergies</MudText>
                @if (!allergies.Any())
                {
                    <MudText>No allergies added yet.</MudText>
                }
                else
                {
                    @foreach (var allergy in allergies)
                    {
                        <div class="d-flex align-center mb-2">
                            <MudText>@allergy.AllergenName (@allergy.SeverityLevel)</MudText>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                           OnClick="@(() => DeleteAllergy(allergy.Id))" />
                        </div>
                    }
                }
            </MudPaper>
        </MudExpansionPanel>

        <MudExpansionPanel Text="Food Preferences">
            <MudPaper Class="pa-4">
                <MudSelect T="DietType" Label="Diet type" @bind-Value="prefModel.DietType" Class="mb-4">
                    @foreach (var dietType in Enum.GetValues<DietType>())
                    {
                        <MudSelectItem T="DietType" Value="@dietType">@dietType</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField Label="Preferred cuisines (comma separated)" @bind-Value="preferredCuisinesText"
                              Class="mb-3" />

                <MudTextField Label="Disliked ingredients (comma separated)" @bind-Value="dislikedIngredientsText"
                              Class="mb-4" />

                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SavePreferences">Save Preferences
                </MudButton>
            </MudPaper>
        </MudExpansionPanel>

        <MudExpansionPanel Text="Overview">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="p-4 rounded-lg shadow-sm h-100" Elevation="2">
                        <MudText Typo="Typo.h6" GutterBottom="true">Calories today</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">Consumed: <b>@todayCalories.ToString("F0") kcal</b> of
                            <b>@dailyCalorieTarget.ToString("F0") kcal</b>
                        </MudText>
                        <MudProgressLinear Value="@TodayCalorieProgress" Color="Color.Primary" Class="mb-2" />
                        <MudText Typo="Typo.caption">Based on your profile goal and weight.</MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Class="p-4 rounded-lg shadow-sm h-100" Elevation="2">
                        <MudText Typo="Typo.h6" GutterBottom="true">Last 24 hours</MudText>
                        @((MarkupString)RenderNutritionChart(last24hTotals, dailyCalorieTarget, "24h"))
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Class="p-4 rounded-lg shadow-sm h-100" Elevation="2">
                        <MudText Typo="Typo.h6" GutterBottom="true">Last 7 days</MudText>
                        @((MarkupString)RenderNutritionChart(last7DaysTotals, dailyCalorieTarget * 7, "7d"))
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="p-4 rounded-lg shadow-sm" Elevation="2">
                        <MudText Typo="Typo.h6">Body Stats</MudText>
                        @if (userProfile == null)
                        {
                            <MudText>No profile data found.</MudText>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between mb-2">
                                <MudText>Weight:</MudText>
                                <MudText><b>@userProfile.Weight kg</b></MudText>
                            </div>
                            <MudText>Goal: <b>@(userProfile.Objective ?? "Not set")</b></MudText>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="p-4 rounded-lg shadow-sm" Elevation="2">
                        <MudText Typo="Typo.h6">Recipe Library</MudText>
                        <div class="text-center py-4">
                            <MudText Typo="Typo.h3" Color="Color.Primary">@recipeCount</MudText>
                            <MudText Typo="Typo.body1">Available Recipes</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-4" Href="/recipes">
                                Browse Recipes
                            </MudButton>
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudPaper Class="p-4 rounded-lg shadow-sm" Elevation="2">
                        <MudText Typo="Typo.h6" GutterBottom="true">Today's Meals</MudText>
                        @if (todayMeals.Count == 0)
                        {
                            <MudText Typo="Typo.body2">No meals logged yet today.</MudText>
                        }
                        else
                        {
                            <MudTable Items="todayMeals" Hover="true" Striped="true" Class="mt-4">
                                <HeaderContent>
                                    <MudTh>Recipe</MudTh>
                                    <MudTh>Time</MudTh>
                                    <MudTh>Calories</MudTh>
                                    <MudTh Style="text-align: right;">Action</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        @if (context.Recipe != null)
                                        {
                                            <MudText Typo="Typo.body2">@context.Recipe.Title</MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2"
                                                     Style="font-style: italic; color: var(--mud-palette-text-secondary);">External
                                                Recipe</MudText>
                                            }
                                        </MudTd>
                                        <MudTd>
                                            <MudText Typo="Typo.body2">@context.EatenAt.ToString("HH:mm")</MudText>
                                        </MudTd>
                                        <MudTd>
                                            <MudText Typo="Typo.body2">@(context.Recipe?.TotalCalories.ToString("F0") ?? "N/A")
                                                kcal</MudText>
                                            </MudTd>
                                            <MudTd Style="text-align: right;">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                               Size="Size.Small" OnClick="@(() => DeleteMealAsync(context.Id))" />
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudContainer>

@code {
    private bool editing = false;
    private UserProfile user = new()
    {
        UserId = Guid.Empty,
        Name = "",
        Gender = "",
        Objective = "",
        Allergies = ""
    };

    private readonly List<AllergyVm> allergies = new();
    private AllergyVm newAllergy = new() { SeverityLevel = AllergySeverity.Mild };

    private FoodPreferenceVm prefModel = new();
    private string preferredCuisinesText = string.Empty;
    private string dislikedIngredientsText = string.Empty;

    private UserProfile? userProfile;
    private int recipeCount = 0;
    private List<DailyLog> recentLogs = new();
    private List<Meal> todayMeals = new();
    private NutritionTotals todayTotals = NutritionTotals.Empty;
    private NutritionTotals last24hTotals = NutritionTotals.Empty;
    private NutritionTotals last7DaysTotals = NutritionTotals.Empty;
    private double dailyCalorieTarget = 2200;
    private double todayCalories = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
        await LoadAllergies();
        await LoadPreferences();
        await LoadRecipeCount();
        await LoadNutritionOverview();
    }

    private async Task LoadProfile()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true) return;

        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim == null || !Guid.TryParse(userIdClaim.Value, out var userId)) return;

        var response = await FetchUserProfileDataAsync(userId);
        if (response == null) return;

        await ProcessProfileResponseAsync(response);
    }

    private async Task<HttpResponseMessage?> FetchUserProfileDataAsync(Guid userId)
    {
        try
        {
            var response = await Http.GetAsync($"api/UserProfile/{userId}");
            if (response.StatusCode == HttpStatusCode.Unauthorized || response.StatusCode == HttpStatusCode.Forbidden)
            {
                await HandleAuthorizationFailure();
                return null;
            }
            return response;
        }
        catch
        {
            editing = true;
            return null;
        }
    }

    private async Task ProcessProfileResponseAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            var existing = await response.Content.ReadFromJsonAsync<UserProfile>();
            if (existing != null)
            {
                user = existing;
                userProfile = existing;
                return;
            }
        }
        
        editing = true;
    }

    private async Task SaveProfile()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);
        
        if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out var userId))
        {
            user.UserId = userId;
            var response = await Http.PostAsJsonAsync("api/userprofile", user);
            
            if (response.StatusCode == HttpStatusCode.Unauthorized || response.StatusCode == HttpStatusCode.Forbidden)
            {
                await HandleAuthorizationFailure();
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                editing = false;
                Snackbar.Add("Profile saved successfully.", Severity.Success);
                await LoadProfile();
                await LoadNutritionOverview();
            }
            else
            {
                Snackbar.Add("Profile could not be saved.", Severity.Error);
            }
        }
    }

    private async Task LoadAllergies()
    {
        try
        {
            var response = await Http.GetAsync("api/Allergies");
            if (response.StatusCode == HttpStatusCode.Unauthorized || response.StatusCode == HttpStatusCode.Forbidden)
            {
                await HandleAuthorizationFailure();
                return;
            }

            allergies.Clear();
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<AllergyVm>>();
                if (result != null) allergies.AddRange(result);
            }
        }
        catch { Snackbar.Add("Could not load allergies.", Severity.Error); }
    }

    private async Task AddAllergy()
    {
        if (string.IsNullOrWhiteSpace(newAllergy.AllergenName))
        {
            Snackbar.Add("Allergen name is required.", Severity.Warning);
            return;
        }

        var response = await Http.PostAsJsonAsync("api/Allergies", newAllergy);
        if (response.StatusCode == HttpStatusCode.Unauthorized || response.StatusCode == HttpStatusCode.Forbidden)
        {
            await HandleAuthorizationFailure();
            return;
        }

        if (response.IsSuccessStatusCode)
        {
            newAllergy = new AllergyVm { SeverityLevel = AllergySeverity.Mild };
            await LoadAllergies();
            Snackbar.Add("Allergy added.", Severity.Success);
        }
        else Snackbar.Add("Could not add allergy.", Severity.Error);
    }

    private async Task DeleteAllergy(Guid id)
    {
        var response = await Http.DeleteAsync($"api/Allergies/{id}");
        if (response.StatusCode == HttpStatusCode.Unauthorized || response.StatusCode == HttpStatusCode.Forbidden)
        {
            await HandleAuthorizationFailure();
            return;
        }

        if (response.IsSuccessStatusCode)
        {
            allergies.RemoveAll(a => a.Id == id);
            Snackbar.Add("Allergy removed.", Severity.Success);
        }
        else Snackbar.Add("Could not remove allergy.", Severity.Error);
    }

    private async Task LoadPreferences()
    {
        try
        {
            var response = await Http.GetAsync("api/FoodPreferences");
            if (response.StatusCode == HttpStatusCode.Unauthorized || response.StatusCode == HttpStatusCode.Forbidden)
            {
                await HandleAuthorizationFailure();
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var existing = await response.Content.ReadFromJsonAsync<FoodPreferenceVm>();
                if (existing != null)
                {
                    prefModel = existing;
                    preferredCuisinesText = string.Join(", ", prefModel.PreferredCuisines);
                    dislikedIngredientsText = string.Join(", ", prefModel.DislikedIngredients);
                }
            }
        }
        catch { Snackbar.Add("Could not load food preferences.", Severity.Warning); }
    }

    private async Task SavePreferences()
    {
        prefModel.PreferredCuisines = ParseCsv(preferredCuisinesText);
        prefModel.DislikedIngredients = ParseCsv(dislikedIngredientsText);

        var response = await Http.PostAsJsonAsync("api/FoodPreferences", prefModel);
        if (response.StatusCode == HttpStatusCode.Unauthorized || response.StatusCode == HttpStatusCode.Forbidden)
        {
            await HandleAuthorizationFailure();
            return;
        }

        if (response.IsSuccessStatusCode) Snackbar.Add("Preferences saved.", Severity.Success);
        else Snackbar.Add("Could not save preferences.", Severity.Error);
    }

    // Făcut 'static' pentru S2325
    private static List<string> ParseCsv(string input) => input.Split(',', StringSplitOptions.TrimEntries |
StringSplitOptions.RemoveEmptyEntries).ToList();

    private async Task LoadRecipeCount()
    {
        try { var recipes = await Http.GetFromJsonAsync<List<RecipeModel>>("api/Recipes"); recipeCount = recipes?.Count ?? 0; }
        catch { /* ignore */ }
    }

    private async Task LoadNutritionOverview()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim == null || !Guid.TryParse(userIdClaim.Value, out var userId)) return;

        dailyCalorieTarget = CalculateDailyCaloriesTarget();

        var dates = Enumerable.Range(0, 7).Select(offset => DateTime.UtcNow.Date.AddDays(-offset)).ToList();
        var requests = dates.Select(date => new
        {
            Date = date,
            Task = Http.GetAsync($"api/DailyLog/{userId}/{date:yyyy-MM-dd}")
        }).ToList();

        await Task.WhenAll(requests.Select(item => item.Task));

        var logs = new List<DailyLog>();
        foreach (var entry in requests)
        {
            var response = await entry.Task;
            if (response.StatusCode == HttpStatusCode.Unauthorized || response.StatusCode == HttpStatusCode.Forbidden)
            {
                await HandleAuthorizationFailure();
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var log = await response.Content.ReadFromJsonAsync<DailyLog>();
                if (log != null) logs.Add(log);
            }
        }

        recentLogs = logs.OrderByDescending(log => log.Date).ToList();
        todayTotals = SumTotals(recentLogs.Where(log => log.Date.Date == DateTime.UtcNow.Date).SelectMany(log => log.Meals));
        last24hTotals = SumTotals(recentLogs.SelectMany(log => log.Meals).Where(meal => meal.EatenAt >=
DateTime.UtcNow.AddHours(-24)));
        last7DaysTotals = SumTotals(recentLogs.SelectMany(log => log.Meals));
        todayCalories = todayTotals.Calories;
        
        var todayLog = recentLogs.FirstOrDefault(log => log.Date.Date == DateTime.UtcNow.Date);
        todayMeals = todayLog?.Meals.OrderByDescending(m => m.EatenAt).ToList() ?? new List<Meal>();
    }

    private double CalculateDailyCaloriesTarget()
    {
        var objective = userProfile?.Objective?.ToLowerInvariant() ?? string.Empty;
        var weight = userProfile?.Weight ?? 0;

        if (weight > 0)
        {
            if (objective.Contains("loss") || objective.Contains("cut") || objective.Contains("diet"))
                return Math.Clamp(weight * 24, 1600, 2600);

            if (objective.Contains("muscle") || objective.Contains("bulk") || objective.Contains("gain"))
                return Math.Clamp(weight * 34, 2200, 3400);

            return Math.Clamp(weight * 30, 1800, 3200);
        }

        if (objective.Contains("loss") || objective.Contains("cut") || objective.Contains("diet")) return 1800;
        if (objective.Contains("muscle") || objective.Contains("bulk") || objective.Contains("gain")) return 2800;

        return 2200;
    }

    private static NutritionTotals SumTotals(IEnumerable<Meal> meals)
    {
        var mealList = meals.Where(meal => meal.Recipe != null).ToList();
        return new NutritionTotals(
            mealList.Sum(meal => (double)meal.Recipe.TotalCalories),
            mealList.Sum(meal => (double)meal.Recipe.TotalProtein),
            mealList.Sum(meal => (double)meal.Recipe.TotalCarbs),
            mealList.Sum(meal => (double)meal.Recipe.TotalFats));
    }

    private double TodayCalorieProgress => dailyCalorieTarget <= 0 ? 0 : Math.Min(100, todayCalories / dailyCalorieTarget *
100);

    private string RenderNutritionChart(NutritionTotals totals, double calorieTarget, string windowLabel)
    {
        var metrics = BuildNutritionMetrics(totals, calorieTarget);
        var rows = string.Join("", metrics.Select(metric => $"<div style='margin-bottom:12px;'><div style='display:flex;justify-content:space-between;gap:12px;margin-bottom:4px;'><span>{metric.Label}</span><span><b>{metric.Value:F0} {metric.Unit}</b> / {metric.Target:F0} {metric.Unit}</span></div><div style='height:10px;background:rgba(0,0,0,0.08);border-radius:999px;overflow:hidden;'><div style='width:{Math.Min(100,
metric.Target <= 0 ? 0 : metric.Value / metric.Target *
100):F0}%;height:100%;background:{metric.Color};border-radius:999px;'></div></div></div>"));
        return $"<div><div style='font-size:12px;opacity:.7;margin-bottom:8px;'>Window: {windowLabel}</div>{rows}</div>";
    }

    // Făcut 'static' pentru S2325
    private static IReadOnlyList<NutritionMetric> BuildNutritionMetrics(NutritionTotals totals, double calorieTarget)
    {
        return new List<NutritionMetric>
        {
            new("Calories", totals.Calories, calorieTarget, "kcal", "var(--mud-palette-primary)"),
            new("Protein", totals.Protein, Math.Max(100, calorieTarget / 20), "g", "var(--mud-palette-success)"),
            new("Carbs", totals.Carbs, Math.Max(180, calorieTarget / 8), "g", "var(--mud-palette-warning)"),
            new("Fats", totals.Fats, Math.Max(50, calorieTarget / 30), "g", "var(--mud-palette-error)"),
        };
    }

    private async Task HandleAuthorizationFailure()
    {
        if (AuthStateProvider is CustomAuthStateProvider customAuth) await customAuth.MarkUserAsLoggedOut();
        Snackbar.Add("Session expired or invalid. Please log in again.", Severity.Warning);
        Navigation.NavigateTo("/login");
    }

    private async Task DeleteMealAsync(Guid mealId)
    {
        var response = await Http.DeleteAsync($"api/DailyLog/meal/{mealId}");
        
        if (response.StatusCode == HttpStatusCode.Unauthorized || response.StatusCode == HttpStatusCode.Forbidden)
        {
            await HandleAuthorizationFailure();
            return;
        }

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Meal deleted successfully.", Severity.Success);
            await LoadNutritionOverview();
        }
        else
        {
            Snackbar.Add("Could not delete meal.", Severity.Error);
        }
    }

    private sealed record NutritionTotals(double Calories, double Protein, double Carbs, double Fats)
    {
        public static NutritionTotals Empty { get; } = new(0, 0, 0, 0);
    }

    private sealed record NutritionMetric(string Label, double Value, double Target, string Unit, string Color);

    // Făcut 'sealed' și `get; init;` pentru S3260, S1144, S3459
    private sealed class AllergyVm
    {
        public Guid Id { get; init; }
        public string AllergenName { get; set; } = string.Empty;
        public AllergySeverity SeverityLevel { get; set; }
    }
    
    // Făcut 'sealed' pentru S3260
    private sealed class FoodPreferenceVm
    {
        public DietType DietType { get; set; } = DietType.None;
        public List<string> PreferredCuisines { get; set; } = new();
        public List<string> DislikedIngredients { get; set; } = new();
    }
}