@page "/plan"
@using Frontend.Models
@using NutritionAdvisor.Domain.Entities
@using NutritionAdvisor.Domain.Enums
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudPaper Class="pa-6 mb-6 meal-plan-hero" Elevation="3">
        <MudText Typo="Typo.h4" Class="mb-2">Nutrition Plan</MudText>
        <MudText Typo="Typo.body1">Create daily meal plans manually or use AI to generate personalized plans.</MudText>
    </MudPaper>

    <MudGrid>
        <!-- Left Panel: Generators -->
        <MudItem xs="12" md="4">
            <MudTabs Outlined="true" Class="h-100">
                <!-- Tab 1: AI Meal Plan Generator -->
                <MudTabPanel Text="AI Generator" Icon="@Icons.Material.Filled.AutoAwesome">
                    <MudPaper Class="pa-5" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-4">Generate with AI</MudText>

                        <MudNumericField Id="ai-days" T="int" Label="Days" @bind-Value="aiDays" Min="1" Max="14"
                                         Class="mb-3" />

                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                   OnClick="GenerateAIMealPlan" Disabled="@(isGeneratingAI || aiGeneratedPlan != null)">
                            @if (isGeneratingAI)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                <span>Generating...</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="me-2" />
                                <span>Generate Meal Plan</span>
                            }
                        </MudButton>

                        @if (aiGeneratedPlan != null)
                        {
                            <MudAlert Severity="Severity.Success" Class="mt-4">Plan generated successfully!</MudAlert>

                            <MudDatePicker Id="ai-plan-date" Label="Select Date" @bind-Date="aiPlanDate"
                                           Class="mt-3 mb-3" />

                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                       OnClick="SaveAIMealPlan" Disabled="@(isSavingAI || !aiPlanDate.HasValue)">
                                @if (isSavingAI)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Save" Class="me-2" />
                                    <span>Save This Plan</span>
                                }
                            </MudButton>

                            <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                                       OnClick="ClearAIPlan" Class="mt-2">
                                Clear
                            </MudButton>
                        }
                    </MudPaper>
                </MudTabPanel>

                <!-- Tab 2: Manual Meal Plan -->
                <MudTabPanel Text="Manual Plan" Icon="@Icons.Material.Filled.Edit">
                    <MudPaper Class="pa-5" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-4">Create Manually</MudText>

                        <MudDatePicker Id="plan-date" Label="Date" @bind-Date="selectedDate" Class="mb-3" />
                        <MudNumericField Id="plan-target-calories" T="int" Label="Target Calories"
                                         @bind-Value="targetCalories" Min="800" Max="5000" Class="mb-3" />

                        <MudSelect Id="breakfast-select" T="Guid?" Label="Breakfast" @bind-Value="breakfastRecipeId"
                                   Class="mb-3">
                            <MudSelectItem T="Guid?" Value="null">Select breakfast</MudSelectItem>
                            @foreach (var recipe in recipes)
                            {
                                <MudSelectItem T="Guid?" Value="@recipe.Id">@recipe.Title</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect Id="lunch-select" T="Guid?" Label="Lunch" @bind-Value="lunchRecipeId" Class="mb-3">
                            <MudSelectItem T="Guid?" Value="null">Select lunch</MudSelectItem>
                            @foreach (var recipe in recipes)
                            {
                                <MudSelectItem T="Guid?" Value="@recipe.Id">@recipe.Title</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect Id="dinner-select" T="Guid?" Label="Dinner" @bind-Value="dinnerRecipeId"
                                   Class="mb-3">
                            <MudSelectItem T="Guid?" Value="null">Select dinner</MudSelectItem>
                            @foreach (var recipe in recipes)
                            {
                                <MudSelectItem T="Guid?" Value="@recipe.Id">@recipe.Title</MudSelectItem>
                            }
                        </MudSelect>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="CreateMealPlan" Disabled="@isSubmitting">
                            Save Meal Plan
                        </MudButton>
                    </MudPaper>
                </MudTabPanel>
            </MudTabs>
        </MudItem>

        <!-- Right Panel: Saved Plans -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-5" Elevation="2">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h6">Saved Plans</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadMealPlans">
                        Refresh
                    </MudButton>
                </div>

                @if (mealPlans == null)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (!mealPlans.Any())
                {
                    <MudAlert Severity="Severity.Info">No meal plans yet. Create the first one on the left.</MudAlert>
                }
                else
                {
                    <MudStack Spacing="3">
                        @foreach (var plan in mealPlans.OrderByDescending(p => p.Date))
                        {
                            <MudCard Elevation="2" Class="pa-4">
                                <div class="d-flex justify-space-between align-center mb-3">
                                    <div>
                                        <MudText Typo="Typo.subtitle1"><b>@plan.Date.ToString("dd MMM yyyy")</b></MudText>
                                        <MudText Typo="Typo.body2">Target: @plan.TargetCalories kcal | Actual:
                                            @plan.TotalCalories kcal</MudText>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <MudChip T="string" Color="@(plan.IsAIGenerated? Color.Secondary: Color.Info)">
                                                @(plan.IsAIGenerated ? "AI generated" : "Manual")
                                            </MudChip>
                                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => OpenDeleteSavedPlanDialog(plan.Id, plan.Date))">
                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="ms-1"
                                                       OnClick="@(() => DeleteSavedPlanDirect(plan.Id, plan.Date))">
                                                <MudText Typo="Typo.caption">Delete now</MudText>
                                            </MudButton>
                                        </div>
                                    </div>

                                    <MudDivider Class="my-3" />

                                    <MudGrid>
                                        @foreach (var item in plan.Items.OrderBy(i => i.MealType))
                                        {
                                            <MudItem xs="12" sm="6">
                                                <MudPaper Class="pa-3" Elevation="0"
                                                          Style="background-color: rgba(255,255,255,0.6); border-radius: 8px;">
                                                    <MudText Typo="Typo.caption" Color="Color.Primary">
                                                        <b>@item.MealType.ToString().ToUpper()</b>
                                                    </MudText>

                                                    @if (item.RecipeId.HasValue && item.RecipeId != Guid.Empty)
                                                    {
                                                        <MudText Typo="Typo.body1" Class="mt-1">
                                                            <MudLink Href="@($"/recipe/{item.RecipeId}")" Color="Color.Dark">
                                                                <b>@(item.Recipe?.Title ?? "Internal Recipe")</b>
                                                            </MudLink>
                                                        </MudText>
                                                    }
                                                    else if (!string.IsNullOrEmpty(item.ExternalUrl))
                                                    {
                                                        <MudText Typo="Typo.body1" Class="mt-1">
                                                            <MudLink Href="@item.ExternalUrl" Target="_blank" Color="Color.Secondary">
                                                                <b>@(item.ExternalTitle ?? "External Recipe")</b>
                                                                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                                                         Class="ms-1" />
                                                            </MudLink>
                                                        </MudText>
                                                    }
                                                    else
                                                    {
                                                        <MudText Typo="Typo.body1" Class="mt-1"><b>@(item.ExternalTitle ?? "Meal")</b>
                                                        </MudText>
                                                    }

                                                    <div class="d-flex gap-2 mt-2 align-center flex-wrap">
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                                            @item.Calories.ToString("F0") kcal
                                                        </MudChip>
                                                        <MudText Typo="Typo.caption" Color="Color.Default">
                                                            P: @item.Protein.ToString("F0")g | C: @item.Carbs.ToString("F0")g | F:
                                                            @item.Fats.ToString("F0")g
                                                        </MudText>
                                                    </div>
                                                </MudPaper>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudCard>
                            }
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- AI Generated Plan Preview -->
        @if (aiGeneratedPlan != null)
        {
            <MudPaper Class="mt-6 pa-5" Elevation="2">
                <MudText Typo="Typo.h5" Class="mb-4">Generated Plan Preview</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">@aiGeneratedPlan.Summary</MudText>

                <MudGrid>
                    @foreach (var day in aiGeneratedPlan.Days)
                    {
                        <MudItem xs="12">
                            <MudCard Elevation="1" Class="pa-3">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <div>
                                        <MudText Typo="Typo.subtitle2"><b>@day.Title (@day.Date) - @day.Calories kcal</b></MudText>
                                        <MudText Typo="Typo.caption">@day.Description</MudText>
                                    </div>
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => OpenDeleteDayDialog(day.Date))">
                                        <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                    </MudButton>
                                </div>

                                <MudGrid Class="mt-3">
                                    @foreach (var item in day.Items)
                                    {
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudPaper Class="pa-2" Elevation="0" Style="background-color: #f5f5f5;">
                                                <MudText Typo="Typo.caption" Color="Color.Primary"><b>@item.MealType</b></MudText>
                                                <MudText Typo="Typo.body2" Class="mt-1">@item.Title</MudText>

                                                @if (!string.IsNullOrEmpty(item.ExternalUrl))
                                                {
                                                    <MudLink Href="@item.ExternalUrl" Target="_blank" Color="Color.Secondary" Class="ms-1">
                                                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                                                        View
                                                    </MudLink>
                                                }

                                                <div class="mt-2">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@item.Calories kcal
                                                    </MudChip>
                                                    <MudText Typo="Typo.caption" Color="Color.Default">
                                                        P: @item.Protein | C: @item.Carbs | F: @item.Fats
                                                    </MudText>
                                                </div>
                                            </MudPaper>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        }
    </MudContainer>

    <!-- Delete Day Dialog -->
    <MudDialog @bind-Open="isDeleteDayDialogOpen">
        <TitleContent>
            <MudText Typo="Typo.h6">Delete Day</MudText>
        </TitleContent>
        <DialogContent>
            <MudText>What would you like to delete?</MudText>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => isDeleteDayDialogOpen = false)" Color="Color.Default">
                Cancel
            </MudButton>
            <MudButton OnClick="DeleteThisDay" Color="Color.Error">
                Delete This Day Only
            </MudButton>
            <MudButton OnClick="@(() => ClearAIPlan())" Color="Color.Warning" Variant="Variant.Filled">
                Delete Entire Plan
            </MudButton>
        </DialogActions>
    </MudDialog>

    <!-- Delete Saved Plan Dialog -->
    <MudDialog @bind-Open="isDeleteSavedPlanDialogOpen">
        <TitleContent>
            <MudText Typo="Typo.h6">Delete Saved Plan</MudText>
        </TitleContent>
        <DialogContent>
            <MudText>Are you sure you want to delete the meal plan for <b>@savedPlanDateToDelete?.ToString("dd MMM yyyy")</b>?</MudText>
            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-3">This action cannot be undone.</MudText>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => isDeleteSavedPlanDialogOpen = false)" Color="Color.Default">
                Cancel
            </MudButton>
            <MudButton OnClick="DeleteSavedPlan" Color="Color.Error" Variant="Variant.Filled">
                Delete Plan
            </MudButton>
        </DialogActions>
    </MudDialog>

@code {
    private List<RecipeModel> recipes = new();
    private List<MealPlan>? mealPlans;
    private DateTime? selectedDate = DateTime.UtcNow.Date;
    private int targetCalories = 2200;
    
    // AI Generator
    private int aiDays = 1;
    private DateTime? aiPlanDate = DateTime.UtcNow.Date;
    private AiMealPlanResponse? aiGeneratedPlan;
    private bool isGeneratingAI;
    private bool isSavingAI;
    
    // Manual Plan
    private Guid? breakfastRecipeId;
    private Guid? lunchRecipeId;
    private Guid? dinnerRecipeId;
    private bool isSubmitting;

    // Delete Dialog
    private bool isDeleteDayDialogOpen;
    private string? deleteDayDate;
    
    // Delete Saved Plan Dialog
    private bool isDeleteSavedPlanDialogOpen;
    private Guid? deleteSavedPlanId;
    private DateTime? savedPlanDateToDelete;

    private readonly JsonSerializerOptions _jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new JsonStringEnumConverter() }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadRecipes();
        await LoadMealPlans();
    }

    private async Task LoadRecipes()
    {
        try
        {
            recipes = await Http.GetFromJsonAsync<List<RecipeModel>>("api/recipes") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load recipes: {ex.Message}", Severity.Error);
            recipes = new();
        }
    }

    private async Task LoadMealPlans()
    {
        try
        {
            mealPlans = await Http.GetFromJsonAsync<List<MealPlan>>("api/mealplans", _jsonOptions) ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load meal plans: {ex.Message}", Severity.Error);
            mealPlans = new();
        }
    }

    private async Task GenerateAIMealPlan()
    {
        isGeneratingAI = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/ai/generate-meal-plan",
            new { days = aiDays }, _jsonOptions);
            
            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                aiGeneratedPlan = JsonSerializer.Deserialize<AiMealPlanResponse>(jsonContent, _jsonOptions);
                Snackbar.Add("Meal plan generated! Choose a date and save it.", Severity.Success);
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Generation failed: {errorMsg}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isGeneratingAI = false;
        }
    }

    private async Task SaveAIMealPlan()
    {
        if (aiGeneratedPlan == null || !aiPlanDate.HasValue)
        {
            Snackbar.Add("No plan to save or date not selected.", Severity.Warning);
            return;
        }

        isSavingAI = true;
        try
        {
            var items = new List<SaveMealPlanItem>();
            
            foreach (var day in aiGeneratedPlan.Days)
            {
                foreach (var item in day.Items)
                {
                    var mealType = Enum.Parse<MealType>(item.MealType);
                    var recipeId = string.IsNullOrEmpty(item.RecipeId) ? null :
                    (Guid?)Guid.Parse(item.RecipeId);
                    
                    items.Add(new SaveMealPlanItem
                    {
                        MealType = mealType,
                        RecipeId = recipeId,
                        ExternalTitle = item.Title,
                        ExternalUrl = item.ExternalUrl,
                        Calories = item.Calories,
                        Protein = item.Protein,
                        Carbs = item.Carbs,
                        Fats = item.Fats
                    });
                }
            }

            var payload = new SaveMealPlanRequest
            {
                Date = aiPlanDate.Value.Date,
                TargetCalories = (int)aiGeneratedPlan.Days.Sum(d => d.Calories),
                IsAIGenerated = true,
                Items = items
            };

            var response = await Http.PostAsJsonAsync("api/mealplans/daily", payload, _jsonOptions);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("AI meal plan saved successfully!", Severity.Success);
                ClearAIPlan();
                await LoadMealPlans();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Save failed: {errorText}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving plan: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSavingAI = false;
        }
    }

    private void ClearAIPlan()
    {
        aiGeneratedPlan = null;
        aiPlanDate = DateTime.UtcNow.Date;
        isDeleteDayDialogOpen = false;
        deleteDayDate = null;
    }

    private void OpenDeleteDayDialog(string dayDate)
    {
        deleteDayDate = dayDate;
        isDeleteDayDialogOpen = true;
        Snackbar.Add($"OpenDeleteDayDialog called for {dayDate}", Severity.Info);
    }

    private void DeleteThisDay()
    {
        if (aiGeneratedPlan == null || string.IsNullOrEmpty(deleteDayDate))
            return;

        aiGeneratedPlan.Days = aiGeneratedPlan.Days
        .Where(d => d.Date != deleteDayDate)
        .ToList();

        isDeleteDayDialogOpen = false;
        deleteDayDate = null;
        StateHasChanged();
        Snackbar.Add($"Day deleted. You can still modify and save the remaining days.",
        Severity.Info);
    }

    private async Task OpenDeleteSavedPlanDialog(Guid planId, DateTime planDate)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete Saved Plan",
            $"Are you sure you want to delete the meal plan for {planDate:dd MMM yyyy}?",
            yesText: "Delete",
            cancelText: "Cancel",
            noText: null
        );

        if (confirmed == true)
        {
            deleteSavedPlanId = planId;
            await DeleteSavedPlan();
        }
    }

    private async Task DeleteSavedPlan()
    {
        Snackbar.Add($"DeleteSavedPlan invoked for {deleteSavedPlanId}", Severity.Info);
        if (!deleteSavedPlanId.HasValue)
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/mealplans/{deleteSavedPlanId.Value}");
            Snackbar.Add($"DELETE /api/mealplans returned {(int)response.StatusCode} {response.ReasonPhrase}", Severity.Info);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Meal plan for {savedPlanDateToDelete?.ToString("dd MMM yyyy")} deleted successfully.", Severity.Success);
                isDeleteSavedPlanDialogOpen = false;
                deleteSavedPlanId = null;
                savedPlanDateToDelete = null;
                await LoadMealPlans();
                StateHasChanged();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Delete failed: {(int)response.StatusCode} {response.ReasonPhrase} - {errorText}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting plan: {ex.Message}", Severity.Error);
        }
    }

    private async Task CreateMealPlan()
    {
        if (selectedDate == null)
        {
            Snackbar.Add("Please choose a date.", Severity.Warning);
            return;
        }

        var items = new List<SaveMealPlanItem>();
        if (breakfastRecipeId.HasValue)
            items.Add(new SaveMealPlanItem
            {
                MealType = MealType.Breakfast,
                RecipeId =
            breakfastRecipeId
            });
        if (lunchRecipeId.HasValue)
            items.Add(new SaveMealPlanItem { MealType = MealType.Lunch, RecipeId = lunchRecipeId });
        if (dinnerRecipeId.HasValue)
            items.Add(new SaveMealPlanItem
            {
                MealType = MealType.Dinner,
                RecipeId = dinnerRecipeId
            });

        if (!items.Any())
        {
            Snackbar.Add("Select at least one recipe.", Severity.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            var payload = new SaveMealPlanRequest
            {
                Date = selectedDate.Value.Date,
                TargetCalories = targetCalories,
                IsAIGenerated = false,
                Items = items
            };

            var response = await Http.PostAsJsonAsync("api/mealplans/daily", payload, _jsonOptions);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Meal plan saved.", Severity.Success);
                breakfastRecipeId = null;
                lunchRecipeId = null;
                dinnerRecipeId = null;
                await LoadMealPlans();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(errorText) ? "Could not save the meal plan." :
                $"Error: {errorText}",
                Severity.Error);
            }
        }
        finally { isSubmitting = false; }
    }

    private async Task DeleteSavedPlanDirect(Guid planId, DateTime planDate)
    {
        Snackbar.Add($"DeleteSavedPlanDirect invoked for {planId}", Severity.Info);
        try
        {
            var response = await Http.DeleteAsync($"api/mealplans/{planId}");
            Snackbar.Add($"Direct DELETE returned {(int)response.StatusCode} {response.ReasonPhrase}", Severity.Info);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Meal plan for {planDate:dd MMM yyyy} deleted (direct).", Severity.Success);
                await LoadMealPlans();
                StateHasChanged();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Direct delete failed: {(int)response.StatusCode} {response.ReasonPhrase} - {errorText}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error in direct delete: {ex.Message}", Severity.Error);
        }
    }

    private class SaveMealPlanRequest
    {
        public DateTime Date { get; set; }
        public int TargetCalories { get; set; }
        public bool IsAIGenerated { get; set; }
        public List<SaveMealPlanItem> Items { get; set; } = new();
    }

    private class SaveMealPlanItem
    {
        public MealType MealType { get; set; }
        public Guid? RecipeId { get; set; }
        public string? ExternalTitle { get; set; }
        public string? ExternalUrl { get; set; }
        public float Calories { get; set; }
        public float Protein { get; set; }
        public float Carbs { get; set; }
        public float Fats { get; set; }
    }

    // AI Response Models
    private class AiMealPlanResponse
    {
        [JsonPropertyName("mode")]
        public string Mode { get; set; } = string.Empty;

        [JsonPropertyName("summary")]
        public string Summary { get; set; } = string.Empty;

        [JsonPropertyName("days")]
        public List<AiMealDay> Days { get; set; } = new();
    }

    private class AiMealDay
    {
        [JsonPropertyName("date")]
        public string Date { get; set; } = string.Empty;

        [JsonPropertyName("title")]
        public string Title { get; set; } = string.Empty;

        [JsonPropertyName("description")]
        public string Description { get; set; } = string.Empty;

        [JsonPropertyName("calories")]
        public int Calories { get; set; }

        [JsonPropertyName("items")]
        public List<AiMealItem> Items { get; set; } = new();
    }

    private class AiMealItem
    {
        [JsonPropertyName("mealType")]
        public string MealType { get; set; } = string.Empty;

        [JsonPropertyName("recipeId")]
        public string? RecipeId { get; set; }

        [JsonPropertyName("title")]
        public string Title { get; set; } = string.Empty;

        [JsonPropertyName("externalUrl")]
        public string? ExternalUrl { get; set; }

        [JsonPropertyName("calories")]
